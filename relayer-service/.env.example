# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Stellar network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_BASE_FEE=100
ALLOW_CUSTOM_HORIZON=false
ALLOW_HTTP_HORIZON=false

# CPINR asset
CPINR_ASSET_CODE=CPINR
CPINR_ASSET_ISSUER=G_CPINR_ISSUER_PUBLIC_KEY

# Backend-only Stellar secrets. Never put these in the mobile app.
SPONSOR_SECRET=S_SPONSOR_SECRET
DISTRIBUTION_SECRET=S_DISTRIBUTION_SECRET

# Sponsored account/trustline policy
STARTING_BALANCE=1.5
TRUSTLINE_LIMIT=1000000000
FEE_BUMP_MULTIPLIER=10
TRANSACTION_TIMEOUT_SECONDS=60

# Add Money policy
ENABLE_ADD_MONEY=true
ADD_MONEY_AMOUNT=100
MAX_ADD_MONEY_AMOUNT=1000
ADD_MONEY_COOLDOWN_MS=86400000
MAX_PAYMENT_AMOUNT=100000
IDEMPOTENCY_TTL_MS=600000

# Security and operations
RELAYER_AUTH_REQUIRED=false
SUPABASE_JWT_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOW_XLM_THRESHOLD=5
LOW_CPINR_THRESHOLD=1000

# Optional alert webhook. The relayer posts low-balance warnings here.
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# QR Code Signing (Issue #12)
# ---------------------------------------------------------------------------
# QR_SIGNING_SECRET enables tamper-evident v3 QR payloads.
# When set, POST /qr/issue returns a signed payload; POST /qr/verify checks it.
# When omitted, both endpoints return 503 and the app falls back to unsigned v2 QRs.
# Generate a secret with: openssl rand -hex 32
QR_SIGNING_SECRET=
QR_DEFAULT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Ledger Ingest Worker (Issue #44)
# ---------------------------------------------------------------------------
# Ingests on-chain Horizon payment operations into the Supabase transactions table
# and reconciles optimistic client-submitted transactions.
LEDGER_INGEST_ENABLED=true
INGEST_POLL_INTERVAL_MS=5000
INGEST_PENDING_TIMEOUT_MS=300000
INGEST_START_CURSOR=

